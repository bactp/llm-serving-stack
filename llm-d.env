# Sourced by every Phase 2 step. Versions come from llm-d v0.9.0's guides/env.sh.
export REPO_ROOT=/home/ubuntu/llm-stack/llm-d
export LLM_D_VERSION=v0.9.0

export GUIDE_NAME=optimized-baseline
export NAMESPACE=llm-d-system

# Gateway: agentgateway (upstream latest; llm-d's doc still pins the stale v1.1.0)
export AGENTGATEWAY_VERSION=v1.5.0
export GATEWAY_CLASS=agentgateway
export PROVIDER_NAME=none          # chart v0.10.0 only knows gke|istio|none; agentgateway needs no extras
export GATEWAY_NAME=llm-d-inference-gateway

# Model server (Phase 2b) - not deployed yet
export ACCELERATOR_TYPE=gpu
export MODEL_SERVER=vllm
export INFRA_PROVIDER=base
export MODEL=Qwen/Qwen3-8B
export CURL_TEST_IMAGE=cfmanteiga/alpine-bash-curl-jq:latest
